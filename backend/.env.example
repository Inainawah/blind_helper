# 複製這份成 backend/.env，並填入真正的值（backend/.env 已被 .gitignore 排除，不會進 git）。
# 對應讀取這些變數的程式碼：backend/db.js、backend/server.js

# --- 資料庫連線（本機開發用）---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blind_helper

# --- 資料庫連線（Railway 正式環境用，db.js 會優先讀這組）---
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# --- Google Maps 後端金鑰（Geocoding API + Directions API）---
# 這是「伺服器端」金鑰：只會在後端呼叫 Google API 時使用，不會外流到瀏覽器，
# 在 Google Cloud Console 設定時建議用「IP 位址」限制，而不是網域限制。
# 既有的 /api/locations、/api/navigation/directions，以及新增的
# /api/tracking/ping（停留點結束時的反向地理編碼）都共用同一把。
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# --- 伺服器埠號 ---
PORT=3000
